{
  "name": "errorvis",
  "displayName": "ErrorVis: Result Unwrap Navigator",
  "description": "Navigate from any Result/Option variable or function to all places it is unwrapped or handled",
  "version": "0.2.0",
  "publisher": "Justin-P-web",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "rust",
    "result",
    "unwrap",
    "error handling",
    "navigation"
  ],
  "activationEvents": [
    "onLanguage:rust"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "errorvis.findResultUsages",
        "title": "Find Result Usages",
        "category": "ErrorVis"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "errorvis.findResultUsages",
          "when": "resourceLangId == rust",
          "group": "navigation@5.5"
        }
      ]
    },
    "configuration": {
      "title": "ErrorVis",
      "properties": {
        "errorvis.enableCodeLens": {
          "type": "boolean",
          "default": true,
          "description": "Show CodeLens annotations above Result/Option-returning functions"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "lint": "eslint src --ext ts",
    "test": "mocha"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "mocha": "^11.7.5",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.21.0",
    "typescript": "^5.3.0"
  }
}
